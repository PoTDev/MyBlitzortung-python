# Generate two different passwords. Hex values work without dotenv escaping.
MARIADB_ROOT_PASSWORD=
MARIADB_PASSWORD=
MARIADB_DATABASE=mybo
MARIADB_USER=mybo

MYBO_ORIGIN=http://127.0.0.1:8080
MYBO_BASE_PATH=
MYBO_BIND_HOST=0.0.0.0
MYBO_BIND_PORT=8080
MYBO_SECURE_COOKIE=false

# Optional emergency superadmin for the site. Use a unique password of at least
# 12 characters. These credentials are unrelated to the Blitzortung feed.
MYBO_SUPERADMIN_LOGIN=
MYBO_SUPERADMIN_PASSWORD=

# Optional geographic restriction for members without admin/legacy unlimited rights.
MYBO_VIEW_RADIUS_KM=0
MYBO_SITE_LAT=0
MYBO_SITE_LON=0

# Empty values use the bundled monochrome Natural Earth country map.
MYBO_TILE_URL=
MYBO_TILE_LABEL_URL=
MYBO_TILE_ATTRIBUTION=

# Use a feed URL and account authorized by Blitzortung. Check the region/path
# in the participant Compendium before enabling. Store secrets in .env (0600).
BO_IMPORT_ENABLED=false
BO_FEED_BASE=https://data.blitzortung.org/Data_1/Protected
BO_FEED_USER=
BO_FEED_PASSWORD=
BO_OWN_STATION=0
BO_POLL_SECONDS=300
BO_STATION_SECONDS=900
BO_LOOKBACK_HOURS=2
